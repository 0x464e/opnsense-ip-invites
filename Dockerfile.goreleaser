# GoReleaser supplies binaries with the tested frontend already embedded.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
WORKDIR /app
COPY --chown=65532:65532 --chmod=0700 deploy/runtime-data/ /data/
COPY $TARGETPLATFORM/opnsense-ip-invites /app/opnsense-ip-invites
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/opnsense-ip-invites"]
CMD ["-config", "/etc/ip-invites/config.yaml"]
